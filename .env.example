# VIGIL configuration — copy this file to ".env" and fill in the values you want.
# Real environment variables always override this file. Never commit your real .env.

# ── AI predictive narrative (the ✨ AI NARRATIVE button) ──
# Get a key at https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-sonnet-5)
# VIGIL_AI_MODEL=claude-sonnet-5

# ── Security (set these before any public deployment) ──
# Signs session cookies. Generate one:  openssl rand -hex 32
AUTH_SECRET=
# Seeds the admin account's password on first run (else a random one is printed).
ADMIN_PASSWORD=
# Set to "false" only for local dev to disable the login gate (default: on).
# AUTH_REQUIRED=true

# ── Optional live intel feeds (work without these; they just stay dormant) ──
# NASA FIRMS satellite thermal/fire detection — free key at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_KEY=
# AIS vessel tracking — a pre-aggregated AIS JSON endpoint, or an aisstream.io key
AIS_HTTP_URL=
AISSTREAM_KEY=

# ── Postgres (only if using the production DB adapter, STORAGE=pg) ──
# STORAGE=pg
# DATABASE_URL=postgres://user:pass@host:5432/vigil
